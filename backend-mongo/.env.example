# --- Core ---
MONGODB_URI=mongodb://localhost:27017/photo-drive
APP_PORT=4000
FRONTEND_URL=http://localhost:5173

# --- JWT ---
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Token encryption (AES-256-GCM key, any 32+ char secret) ---
ENCRYPTION_KEY=change-me-encryption-key-min-32-chars

# --- Uploads (bytes, default 100MB) ---
MAX_UPLOAD_BYTES=104857600

# --- Google OAuth / Drive ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
# Comma-separated scopes. drive.file = app-created files only, drive = full access.
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile

# --- Email (choose one) ---
# Option A: Resend
RESEND_API_KEY=
# Option B: SMTP (used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PhotoDrive <no-reply@example.com>"
