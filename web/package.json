{
  "name": "immich-web",
  "version": "1.0.0",
  "license": "GNU Affero General Public License version 3",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:stats": "BUILD_STATS=true vite build",
    "package": "svelte-kit package",
    "preview": "vite preview",
    "check:svelte": "svelte-check --no-tsconfig --fail-on-warnings --compiler-warnings 'state_referenced_locally:ignore'",
    "check:typescript": "tsc --noEmit",
    "check:watch": "npm run check:svelte -- --watch",
    "check:code": "npm run format && npm run lint && npm run check:svelte && npm run check:typescript",
    "lint": "eslint . --max-warnings 0 --concurrency 6",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write --list-different .",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@formatjs/icu-messageformat-parser": "^3.0.0",
    "@immich/justified-layout-wasm": "^0.4.3",
    "@immich/ui": "^0.83.0",
    "@mdi/js": "^7.4.47",
    "@zoom-image/core": "^0.42.0",
    "intl-messageformat": "^11.0.0",
    "justified-layout": "^4.1.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.4.4",
    "media-chrome": "^4.19.2",
    "svelte-gestures": "^5.2.2",
    "svelte-i18n": "^4.0.1",
    "svelte-persisted-store": "^0.12.0",
    "tabbable": "^6.2.0",
    "tailwind-merge": "^3.5.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@eslint/js": "^10.0.0",
    "@koddsson/eslint-plugin-tscompat": "^0.2.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.56.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/justified-layout": "^4.1.4",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-compat": "^7.0.0",
    "eslint-plugin-svelte": "^3.12.4",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-svelte": "^4.0.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "svelte": "5.56.5",
    "svelte-check": "^4.4.6",
    "svelte-eslint-parser": "^1.3.3",
    "tailwindcss": "^4.2.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.0.0"
  }
}
