{
  "background_color": "#0B1026",
  "theme_color": "#0B1026",
  "description": "Your photos from every drive, in one place.",
  "dir": "auto",
  "display": "standalone",
  "orientation": "portrait",
  "icons": [
    {
      "purpose": "any",
