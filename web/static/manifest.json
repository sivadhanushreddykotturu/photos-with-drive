    },
    {
      "purpose": "any",
      "sizes": "512x512",
      "src": "manifest-icon-512.maskable.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "512x512",
      "src": "manifest-icon-512.maskable.png",
      "type": "image/png"
    }
  ],
  "lang": "en",
